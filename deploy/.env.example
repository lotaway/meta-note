# Release stack configuration template.
# Copy to .env and fill in real values; .env is ignored by git.
# Every variable has a default in docker-compose.yml, so leaving a line blank
# means "use the default". Defaults are development-grade and MUST be replaced
# for a real factory deployment.

# Published images. Built by meta-web-three CI, or loaded from an offline
# docker save bundle. The 0.0.0-dev placeholder does not exist yet.
# GATEWAY_IMAGE default: ghcr.io/lotaway/meta-web-three-gateway:0.0.0-dev
GATEWAY_IMAGE=
# FACTORY_SERVICE_IMAGE default: ghcr.io/lotaway/meta-web-three-factory-service:0.0.0-dev
FACTORY_SERVICE_IMAGE=
# MALL_USER_SERVICE_IMAGE default: ghcr.io/lotaway/meta-web-three-mall-user-service:0.0.0-dev
MALL_USER_SERVICE_IMAGE=

# Middleware image pins. Defaults: zookeeper:3.9, postgres:16, redis:7,
# confluentinc/cp-kafka:7.6.1
ZOOKEEPER_IMAGE=
POSTGRES_IMAGE=
REDIS_IMAGE=
KAFKA_IMAGE=
# KAFKA_CLUSTER_ID default: b28ea04f9004080a4a34207b23292d3
KAFKA_CLUSTER_ID=

# The only host-facing port of the whole stack. Default: 10081
GATEWAY_PORT=

# Shared secrets. JWT_SECRET must be identical in gateway, factory-service and
# mall-user-service (signer vs validator). INTERNAL_TOKEN_SECRET must match
# between gateway (signer) and factory-service (validator).
JWT_SECRET=
INTERNAL_TOKEN_SECRET=

# Database and cache. POSTGRES_DB and the database in DATASOURCE_URL must be
# the same library; both default to metawebthree.
# DATASOURCE_URL default: jdbc:postgresql://postgres:5432/metawebthree
DATASOURCE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
REDIS_PASSWORD=
