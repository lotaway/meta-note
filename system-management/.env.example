# Desktop app
APP_PROTOCOL= # default: meta-note
WEBSOCKET_PORT= # default: 5050
WEB_SERVER_PORT= # default: 5051
DEV_SERVER_PORT= # default: 5173
WINDOW_WIDTH= # default: 1200
WINDOW_HEIGHT= # default: 800
NODE_ENV= # default: production
PROXY_URL= # optional, for external chat sites
LOCAL_API_TOKEN= # optional; when unset a random per-session token is generated for the local HTTP API
DEEPSEEK_SESSION_COOKIE_NAME= # default: ds_session_token

# Voice and transcription services
VITE_VOICE_API_URL= # default: http://localhost:8000
WHISPER_URL= # default: http://localhost:8081/v1/audio/transcriptions
WHISPER_MODEL= # default: whisper-1

# LLM providers
LOCAL_LLM_PROVIDER= # optional, e.g. http://localhost:11434 (Ollama)

# Kafka and Redis for the study queue
KAFKA_BROKER= # default: localhost:9092
REDIS_HOST= # default: localhost
REDIS_PORT= # default: 6379
REDIS_PASSWORD= # optional
STUDY_LIST_LIMIT_COUNT= # default: 10
STUDY_LIMIT_TIME= # default: 45 (minutes)

# Cross-service access (server/ in meta-web-three): gateway + zookeeper only.
# Do NOT configure backend service ports (10101 / 8082 / 8080) here: every
# digital-twin, alert-rule and MES request is sent to /factory-service/** on
# the gateway, which resolves the service through zookeeper and validates JWT.
# These backend ports are unrelated to this desktop app's local ports: the
# embedded llama-server binds 8080 locally and Whisper binds 8081. See the
# port table in README.md.
VITE_GATEWAY_HOST= # default: localhost
VITE_GATEWAY_PORT= # default: 10081
VITE_GATEWAY_URL= # optional full URL override, e.g. http://localhost:10081
GATEWAY_AUTH_URL= # optional override for admin login/refresh; defaults to VITE_GATEWAY_URL / host:port

# Standard path: a dedicated admin account created by the default administrator.
# Run `npm run bootstrap:gateway-account` once (see README), then put the same
# username/password here. The main process logs in through the gateway and
# refreshes the JWT before it expires; credentials never reach the renderer.
GATEWAY_SERVICE_ACCOUNT_USERNAME= # default for bootstrap: digital-twin
GATEWAY_SERVICE_ACCOUNT_PASSWORD= # required for login; keep it out of version control

# Only used by the one-off bootstrap script to call /admin/register.
BOOTSTRAP_ADMIN_USERNAME= # default administrator, e.g. admin
BOOTSTRAP_ADMIN_PASSWORD=
GATEWAY_SERVICE_ACCOUNT_ROLE_IDS= # optional, e.g. 3001 (comma separated)

# Break-glass only: a manually issued JWT. When set, login/refresh is skipped.
# Prefer the service account above; a static JWT needs manual rotation.
GATEWAY_TOKEN=
